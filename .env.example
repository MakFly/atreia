# Serveur Hono
PORT=8787
NODE_ENV=production
LOG_LEVEL=info
# Origines autorisées pour l'API (séparées par des virgules). Vide = même origine uniquement.
CORS_ORIGINS=
# Dossier des guides Markdown et du build web (valeurs par défaut adaptées à l'image Docker)
CONTENT_DIR=/app/packages/content/guides
WEB_DIST_DIR=/app/apps/web/dist

# Site Astro (build) : URL publique pour les canoniques, Open Graph, sitemap et robots.txt
SITE_URL=https://atreia.example

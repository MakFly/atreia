# Serveur Hono
PORT=8787
NODE_ENV=production
LOG_LEVEL=info
# Origines autorisées pour l'API (séparées par des virgules). Vide = même origine uniquement.
CORS_ORIGINS=
# Catalogue SQLite des guides et build web : les valeurs par défaut suivent le dépôt, ne les définir que pour les déplacer.
# Seul le processus Hono ouvre ce fichier. Les pages passent par l'API.
# GUIDES_DB=packages/content/guides.sqlite
# WEB_DIST_DIR=apps/web/dist
# Dev Astro, si le site n'est pas lancé par make dev : origine de l'API Hono.
# GUIDES_API_ORIGIN=http://127.0.0.1:8787

# Site Astro (build) : URL publique pour les canoniques, Open Graph, sitemap et robots.txt
SITE_URL=https://atreia.example

# Votes publics : connexion Redis serveur uniquement (jamais de préfixe PUBLIC_).
# Local : utilisateur dédié, clés atreia:class-votes:*, port loopback vérifié.
# Processus sur cet hôte : port loopback publié par infra-redis.
# VOTES_REDIS_URL=redis://atreia-votes:password@127.0.0.1:6379
# Conteneur applicatif sur dev-shared-net : utiliser infra-redis:6379.
# Sur PVE : définir la connexion du Redis de cet environnement et SITE_URL
# avec l’origine HTTPS publique (validation des votes derrière le reverse proxy).

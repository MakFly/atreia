{
  "name": "aion2-atreia",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter './apps/*' dev",
    "build": "bun --filter @aion2/web build && bun --filter @aion2/server build",
    "start": "bun --filter @aion2/server start",
    "build:preview": "bun --filter @aion2/web build && bun scripts/export-preview.mjs",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter '*' test && bun test scripts/"
  }
}

{
  "name": "aion2-atreia",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter @aion2/web build && pnpm --filter @aion2/server build",
    "start": "pnpm --filter @aion2/server start",
    "build:preview": "pnpm --filter @aion2/web build && node scripts/export-preview.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  }
}

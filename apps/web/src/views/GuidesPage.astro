---
import { BookOpenTextIcon } from "lucide-react";
import Breadcrumb from "@/components/Breadcrumb.astro";
import GameHero from "@/components/GameHero.astro";
import PostCard from "@/components/PostCard.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import Base from "@/layouts/Base.astro";
import { catColor } from "@/lib/cats";
import { guidesByCategory } from "@/lib/guides";
import { ui, type Locale } from "@/lib/i18n";

interface Props { locale: Locale }
const { locale } = Astro.props;

const groups = await guidesByCategory(locale);
const descriptions = { actu: ui(locale, "Patches, maintenance and what comes next.", "Patchs, maintenances et ce qui arrive ensuite."), "bien-demarrer": ui(locale, "Servers, factions and first steps.", "Serveur, faction et premiers pas."), classes: ui(locale, "Builds, rotations and leveling routes.", "Builds, rotations et routes de leveling."), kinah: ui(locale, "Market, farming, shop and subscription.", "Marché, farm, boutique et abonnement."), ressources: ui(locale, "Recommended sites, tools and communities.", "Les meilleurs sites, outils et communautés.") };
---
<Base locale={locale} title={ui(locale, "All guides", "Tous les guides")} description={ui(locale, "AION 2 guides organized by topic: getting started, classes and builds, Kinah, resources and news.", "Tous les guides AION 2 en français, rangés par rubrique : bien démarrer, classes et builds, Kinah, ressources et actualités.")}>
  <div class="mx-auto max-w-[1374px] md:px-[24px]">
    <GameHero name="AION 2" compact />
    <div class="mt-[20px]">
      <Breadcrumb items={[{ label: ui(locale, "Home", "Accueil"), href: locale === "fr" ? "/fr/" : "/" }, { label: ui(locale, "Guides", "Guides") }]} />
    </div>
    <div class="mt-[32px] px-[20px]">
      <SectionTitle as="h1" icon={BookOpenTextIcon} title={ui(locale, "All guides", "Tous les guides")} color="#057af0" />
      <nav aria-label={ui(locale, "Categories", "Rubriques")} class="mt-[20px] flex flex-wrap gap-[8px]">
        {groups.map((g) => (
          <a href={`#${g.key}`} class="flex h-[32px] items-center gap-[10px] rounded-[8px] bg-[#121212] px-[12px] text-[16px] font-semibold text-[#95989b] uppercase shadow-[inset_0_0_0_1px_#2b2c2c] hover:text-white">
            <span class="size-[14px] rounded-[3px]" style={`background:${catColor(g.key)}`} aria-hidden="true"></span>{g.label}
          </a>
        ))}
      </nav>
      <div class="mt-[40px] flex flex-col gap-[48px]">
        {groups.map((g) => (
          <section id={g.key} aria-labelledby={`t-${g.key}`}>
            <h2 id={`t-${g.key}`} class="border-l-[4px] pl-[10px] text-[22px] leading-[24px] font-semibold text-white uppercase" style={`border-color:${catColor(g.key)}`}>{g.label}</h2>
            <p class="mt-[6px] text-[14px] text-[#95989b]">{descriptions[g.key]}</p>
            {g.guides.length > 0
              ? <ul class="mt-[16px] grid gap-[8px] sm:grid-cols-2 lg:grid-cols-4">{g.guides.map((guide) => <li><PostCard guide={guide} /></li>)}</ul>
              : <p class="mt-[16px] rounded-[8px] border border-dashed border-[#2b2c2c] p-[16px] text-[14px] text-[#737373]">{ui(locale, "No guides in this category yet.", "Aucun guide pour l'instant dans cette rubrique.")}</p>}
          </section>
        ))}
      </div>
    </div>
  </div>
</Base>

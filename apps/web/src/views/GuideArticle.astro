---
import { CLASSES, type Guide } from "@aion2/shared/browser";
import { CheckIcon, LinkIcon, ThumbsDownIcon, ThumbsUpIcon, XIcon } from "lucide-react";
import ClassSigil from "@/components/ClassSigil.astro";
import MermaidSkeleton from "@/components/MermaidSkeleton.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import GameHero from "@/components/GameHero.astro";
import Grade from "@/components/Grade.astro";
import Picture from "@/components/Picture.astro";
import Base from "@/layouts/Base.astro";
import { catColor } from "@/lib/cats";
import { categoryLabels, ui, type Locale, dateLocale } from "@/lib/i18n";
import { renderGuideMarkdown } from "@/lib/markdown";

const CLASS_NAMES: Record<string, string> = { gladiateur: "Gladiator", templier: "Templar", assassin: "Assassin", rodeur: "Ranger", sorcier: "Sorcerer", spiritualiste: "Spiritmaster", clerc: "Cleric", chantre: "Chanter" };

interface Props { guide: Guide; locale: Locale }
const { guide, locale } = Astro.props;
const { html, headings } = await renderGuideMarkdown(guide.body, locale, guide.slug);
const toc = headings.filter((heading) => heading.depth === 2);
const hasDisclosures = guide.body.includes('class="guide-disclosure"');
const url = new URL(Astro.url.pathname, Astro.site).href;
const article = {
  "@type": "Article",
  "@id": `${url}#article`,
  headline: guide.title,
  description: guide.summary,
  inLanguage: locale === "fr" ? "fr-FR" : "en-GB",
  dateModified: guide.updated,
  mainEntityOfPage: url,
  isPartOf: { "@id": new URL(`${locale === "fr" ? "/fr/" : "/"}#site`, Astro.site).href },
  author: { "@type": "Organization", name: "Atreia", url: new URL(locale === "fr" ? "/fr/" : "/", Astro.site).href },
  publisher: { "@type": "Organization", name: "Atreia" },
  about: { "@id": new URL(`${locale === "fr" ? "/fr/" : "/"}#game`, Astro.site).href },
  keywords: guide.tags.join(", "),
  ...(guide.cover && { image: new URL(guide.cover.src, Astro.site).href }),
};
---
<Base locale={locale} title={guide.title} description={guide.summary} image={guide.cover} type="article" modified={guide.updated} jsonLd={[article]}>
  <div class="mx-auto max-w-[1374px] md:px-[24px]">
    <GameHero name="AION 2" compact />
    <div class="mt-[20px]">
      <Breadcrumb items={[{ label: ui(locale, "Home", "Accueil"), href: locale === "fr" ? "/fr/" : "/" }, { label: ui(locale, "Guides", "Guides"), href: locale === "fr" ? "/fr/guides/" : "/guides/" }, { label: guide.title }]} />
    </div>

    <!-- Relevé maxroll.gg : colonne gauche 210 px (auteur + sommaire collant), contenu 1030 px, écart 16 px. -->
    <div class="mt-[32px] grid gap-[16px] px-[20px] lg:grid-cols-[210px_minmax(0,1fr)]">
      <aside class="hidden flex-col gap-[12px] lg:flex">
        {guide.classes.length > 0 && (
          <div class="overflow-hidden rounded-[8px] bg-[#121212] shadow-[inset_0_0_1px_0_#2b2c2c]">
            <p class="pt-[16px] text-center text-[18px] leading-[18px] font-semibold text-white uppercase">{ui(locale, "Classes", "Classes")}</p>
            <ul class="flex flex-col items-center gap-[10px] px-[12px] py-[16px]">
              {guide.classes.map((c) => (
                <li class="flex flex-col items-center gap-[4px]">
                  <ClassSigil cls={c} class="size-[72px]" />
                  <span class="text-[16px] leading-[20px] font-semibold text-white">{locale === "en" ? CLASS_NAMES[c] ?? CLASSES[c].name : CLASSES[c].name}</span>
                  <span class="text-[13px] leading-[16px] text-[#95989b] italic">{locale === "en" ? ({ "Arme à deux mains": "Two-handed weapon", "Épée et bouclier": "Sword and shield", "Deux dagues": "Dual daggers", Arc: "Bow", Grimoire: "Spellbook", Orbe: "Orb", Masse: "Mace", Bâton: "Staff" } as Record<string, string>)[CLASSES[c].weapon] ?? CLASSES[c].weapon : CLASSES[c].weapon}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
        {toc.length > 0 && (
          <nav aria-label={ui(locale, "Contents", "Sommaire")} class="sticky top-[80px] overflow-hidden rounded-[8px] bg-[#121212] shadow-[inset_0_0_1px_0_#2b2c2c]">
            <p class="px-[12px] py-[16px] text-center text-[18px] leading-[22.5px] font-semibold text-white uppercase">{ui(locale, "Contents", "Sommaire")}</p>
            <ol class="flex flex-col gap-[4px] px-[12px] pb-[12px]">
              {toc.map((h, i) => (
                <li>
                  <a href={`#${h.slug}`} data-toc={h.slug}
                    class="relative flex gap-[6px] rounded-[4px] bg-[#171717] py-[8px] pr-[8px] pl-[14px] text-[14px] leading-[18px] text-[#95989b] transition-colors hover:text-white data-[active]:font-semibold data-[active]:text-white">
                    <span class="absolute top-[10px] bottom-[10px] left-[4px] hidden w-[3px] rounded-full bg-[#057af0] [[data-active]>&]:block" aria-hidden="true"></span>
                    {!hasDisclosures && !/^\d+[.)]/.test(h.text) && <span>{i + 1}.</span>}<span>{h.text}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )}
      </aside>

      <article class="flex min-w-0 flex-col gap-[24px]">
        <h1 class="text-[26px] leading-[34px] font-semibold text-[#e8e8e8] md:text-[32px] md:leading-[40px]">{guide.title}</h1>

        {guide.cover && (
          <figure class="overflow-hidden rounded-[8px] shadow-[inset_0_0_1px_0_#2b2c2c]">
            <Picture src={guide.cover.src} alt={guide.cover.alt} eager class="aspect-[21/9] max-h-[360px] w-full object-cover" />
            <figcaption class="bg-[#121212] px-[12px] py-[6px] text-[12px] leading-[16px] text-[#737373]">{guide.cover.alt} · © NC Corporation</figcaption>
          </figure>
        )}

        <!-- Bloc d'en-tête : infos à gauche, actions au centre, « L'essentiel » à la place de l'encart pub. -->
        <div class="grid gap-[8px] xl:grid-cols-[minmax(0,1fr)_300px]">
          <div class="flex flex-col gap-[16px] rounded-[8px] bg-[#121212] p-[12px] shadow-[inset_0_0_1px_0_#2b2c2c] sm:flex-row sm:justify-between">
            <div class="flex flex-col gap-[8px]">
              <p class="text-[16px] text-[#95989b]">{ui(locale, "by ", "par ")}<span class="font-semibold text-[#e8e8e8]">Atreia</span></p>
              <p class="text-[20px] leading-[24px] font-medium text-[#dadada]">{guide.patch}</p>
              <p class="text-[16px] text-[#737373]">{ui(locale, "Last updated: ", "Dernière mise à jour : ")}{new Intl.DateTimeFormat(dateLocale(locale), { day: "numeric", month: "long", year: "numeric" }).format(new Date(`${guide.updated}T12:00:00`))}{guide.status === "publie" && <> · {guide.readingMinutes} {ui(locale, "min read", "min de lecture")}</>}</p>
              <div class="flex flex-wrap gap-[6px]">
                <span class="flex items-center gap-[6px] rounded-[4px] bg-[#171717] px-[10px] text-[14px] leading-[24px] text-[#95989b] shadow-[inset_0_0_1px_0_#2b2c2c]">
                  <span class="size-[8px] rounded-[2px]" style={`background:${catColor(guide.category)}`} aria-hidden="true"></span>{categoryLabels[locale][guide.category]}
                </span>
                {guide.status === "a-venir" && <span class="rounded-[4px] bg-[#ffb547] px-[10px] text-[14px] leading-[24px] font-semibold text-black">{ui(locale, "In preparation", "En préparation")}</span>}
              </div>
            </div>
            <div class="flex shrink-0 gap-[8px] self-start">
              <button type="button" data-copy-link data-copy-success={ui(locale, "Link copied", "Lien copié")} data-copy-reset={ui(locale, "Copy link", "Copier le lien")} data-copy-prompt={ui(locale, "Copy this link:", "Copie ce lien :")}
                class="flex h-[36px] items-center gap-[8px] rounded-[8px] bg-[#171717] px-[14px] text-[16px] font-semibold text-[#dadada] shadow-[inset_0_0_1px_0_#2b2c2c,0_0_1px_0_#2b2c2c] transition-colors hover:text-white">
                <LinkIcon className="size-[16px] text-[#057af0]" /><span data-copy-label>{ui(locale, "Copy link", "Copier le lien")}</span>
              </button>
            </div>
          </div>
          {guide.highlights.length > 0 && (
            <section aria-label={ui(locale, "Key takeaways", "L'essentiel")} class="rounded-[8px] bg-[#121212] p-[12px] shadow-[inset_0_0_1px_0_#2b2c2c]">
              <p class="text-center text-[18px] leading-[22.5px] font-semibold text-white uppercase">{ui(locale, "Key takeaways", "L'essentiel")}</p>
              <ul class="mt-[10px] flex flex-col gap-[8px]">
                {guide.highlights.map((h) => (
                  <li class="flex gap-[8px] text-[14px] leading-[20px] text-[#dadada]"><CheckIcon className="mt-[2px] size-[16px] shrink-0 text-[#6ab525]" aria-hidden="true" /><span>{h}</span></li>
                ))}
              </ul>
            </section>
          )}
        </div>

        <p class="text-[16px] leading-[24px] text-[#dadada]">{guide.summary}</p>

        {guide.ratings.length > 0 && (
          <ul class="grid grid-cols-2 gap-[8px] sm:grid-cols-4" aria-label={ui(locale, "Build ratings", "Notes du build")}>
            {guide.ratings.map((r) => (
              <li class="flex items-center gap-[10px] rounded-[8px] bg-[#121212] p-[10px] shadow-[inset_0_0_1px_0_#2b2c2c]">
                <Grade grade={r.grade} size="md" /><span class="text-[16px] font-semibold text-white">{r.label}</span>
              </li>
            ))}
          </ul>
        )}

        {(guide.pros.length > 0 || guide.cons.length > 0) && (
          <div class="grid gap-[12px] sm:grid-cols-2">
            <div class="overflow-hidden rounded-[8px] bg-[#121212] shadow-[inset_0_0_1px_0_#2b2c2c]">
              <p class="inline-flex h-[36px] items-center gap-[8px] rounded-br-[8px] bg-[#1d4d24] px-[16px] text-[18px] font-semibold text-white"><ThumbsUpIcon className="size-[16px]" />{ui(locale, "Strengths", "Points forts")}</p>
              <ul class="flex flex-col gap-[8px] p-[16px]">
                {guide.pros.map((p) => <li class="flex gap-[8px] text-[14px] leading-[20px] text-[#dadada]"><CheckIcon className="mt-[2px] size-[14px] shrink-0 text-[#6ab525]" aria-hidden="true" />{p}</li>)}
              </ul>
            </div>
            <div class="overflow-hidden rounded-[8px] bg-[#121212] shadow-[inset_0_0_1px_0_#2b2c2c]">
              <p class="inline-flex h-[36px] items-center gap-[8px] rounded-br-[8px] bg-[#5c1515] px-[16px] text-[18px] font-semibold text-white"><ThumbsDownIcon className="size-[16px]" />{ui(locale, "Weaknesses", "Points faibles")}</p>
              <ul class="flex flex-col gap-[8px] p-[16px]">
                {guide.cons.map((c) => <li class="flex gap-[8px] text-[14px] leading-[20px] text-[#dadada]"><XIcon className="mt-[2px] size-[14px] shrink-0 text-[#f05252]" aria-hidden="true" />{c}</li>)}
              </ul>
            </div>
          </div>
        )}

        <div class="prose-guide">
          {hasDisclosures && <div data-guide-expand-controls hidden class="flex flex-wrap gap-2">
            <button type="button" data-guide-expand class="min-h-11 rounded-md border border-[#404040] px-4 text-sm font-semibold text-[#dadada] hover:border-[#95989b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{ui(locale, "Expand all details", "Tout déplier")}</button>
            <button type="button" data-guide-collapse class="min-h-11 rounded-md border border-[#404040] px-4 text-sm font-semibold text-[#dadada] hover:border-[#95989b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">{ui(locale, "Collapse all details", "Tout replier")}</button>
          </div>}
          <Fragment set:html={html} />
        </div>
        <template id="mermaid-skeleton">
          <MermaidSkeleton label={ui(locale, "Loading the diagram", "Chargement du schéma")} />
        </template>
        <script is:inline>
          const mermaidSkeleton = document.getElementById("mermaid-skeleton");
          if (mermaidSkeleton instanceof HTMLTemplateElement) {
            for (const block of document.querySelectorAll(".prose-guide pre[data-language='mermaid']")) {
              const host = document.createElement("div");
              host.className = "mermaid-diagram";
              host.setAttribute("aria-busy", "true");
              host.dataset.mermaid = block.querySelector("code")?.textContent?.trim() ?? "";
              host.append(mermaidSkeleton.content.cloneNode(true));
              block.replaceWith(host);
            }
          }
        </script>
      </article>
    </div>
  </div>
</Base>

<script>
  // Mermaid draws in the browser: the package needs a DOM to sanitize labels.
  const mermaidHosts = [...document.querySelectorAll<HTMLElement>('.prose-guide .mermaid-diagram[aria-busy="true"]')];
  if (mermaidHosts.length > 0) {
    const { default: mermaid } = await import("mermaid");
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: "strict",
      theme: "base",
      darkMode: true,
      fontFamily: '"Source Sans 3 Variable", "Source Sans 3", sans-serif',
      htmlLabels: true,
      flowchart: {
        useMaxWidth: true,
        curve: "basis",
        nodeSpacing: 36,
        rankSpacing: 48,
        padding: 14,
        wrappingWidth: 220,
      },
      themeVariables: {
        darkMode: true,
        background: "transparent",
        fontFamily: '"Source Sans 3 Variable", "Source Sans 3", sans-serif',
        fontSize: "16px",
        primaryColor: "#1c1c1c",
        primaryTextColor: "#e8e8e8",
        primaryBorderColor: "#057af0",
        secondaryColor: "#171717",
        secondaryTextColor: "#e8e8e8",
        secondaryBorderColor: "#057af0",
        tertiaryColor: "#121212",
        tertiaryTextColor: "#dadada",
        tertiaryBorderColor: "#2b2c2c",
        lineColor: "#95989b",
        textColor: "#e8e8e8",
        mainBkg: "#1c1c1c",
        nodeBorder: "#057af0",
        nodeTextColor: "#e8e8e8",
        titleColor: "#e8e8e8",
        clusterBkg: "transparent",
        edgeLabelBackground: "#121212",
      },
    });
    for (const [index, host] of mermaidHosts.entries()) {
      const definition = host.dataset.mermaid ?? "";
      delete host.dataset.mermaid;
      try {
        const { svg } = await mermaid.render(`guide-mermaid-${index}`, definition);
        host.innerHTML = svg;
        host.removeAttribute("aria-busy");
      } catch (error) {
        const pre = document.createElement("pre");
        pre.dataset.language = "mermaid";
        const code = document.createElement("code");
        code.textContent = definition;
        pre.append(code);
        host.replaceWith(pre);
        console.error(error);
      }
    }
  }
</script>

<script>
  // Bulk controls enhance native disclosures; each section works without JS.
  const guideDisclosures = document.querySelectorAll<HTMLDetailsElement>(".prose-guide details.guide-disclosure");
  if (guideDisclosures.length > 0) {
    document.querySelector<HTMLElement>("[data-guide-expand-controls]")?.removeAttribute("hidden");
    document.querySelector("[data-guide-expand]")?.addEventListener("click", () => guideDisclosures.forEach((section) => { section.open = true; }));
    document.querySelector("[data-guide-collapse]")?.addEventListener("click", () => guideDisclosures.forEach((section) => { section.open = false; }));
  }

  // Surligne la section en cours dans le sommaire.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>("[data-toc]")].map((a) => [a.dataset.toc!, a]),
  );
  if (links.size > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => a.removeAttribute("data-active"));
          links.get(e.target.id)?.setAttribute("data-active", "");
        }
      },
      { rootMargin: "-90px 0px -70% 0px" },
    );
    links.forEach((_a, id) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  }

  // Copy the link to the clipboard, with a prompt fallback.
  document.querySelector<HTMLButtonElement>("[data-copy-link]")?.addEventListener("click", async (e) => {
    const button = e.currentTarget as HTMLButtonElement;
    const label = button.querySelector<HTMLElement>("[data-copy-label]");
    try {
      await navigator.clipboard.writeText(location.href.split("#")[0] ?? location.href);
      if (label) { label.textContent = button.dataset.copySuccess ?? "Copied"; setTimeout(() => (label.textContent = button.dataset.copyReset ?? "Copy link"), 2000); }
    } catch {
      prompt(button.dataset.copyPrompt ?? "Copy this link:", location.href);
    }
  });
</script>

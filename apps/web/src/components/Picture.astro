---
// Image de public/assets : WebP d'abord, JPEG en repli, dimensions explicites contre les décalages de mise en page.
import { imageSize, webpOf } from "@/lib/images";
interface Props { src: string; alt: string; class?: string; eager?: boolean }
const { src, alt, class: className, eager = false } = Astro.props;
const { width, height } = imageSize(src);
---
<picture>
  <source srcset={webpOf(src)} type="image/webp" />
  <img src={src} alt={alt} width={width} height={height} class={className}
    loading={eager ? "eager" : "lazy"} decoding="async" fetchpriority={eager ? "high" : "auto"} />
</picture>

---
import "@fontsource-variable/source-sans-3";
import "@fontsource-variable/oswald";
import "@/styles/global.css";
import GameNav from "@/components/GameNav.astro";
import Logo from "@/components/Logo.astro";
import MobileNav from "@/components/MobileNav";
import PrefsControls from "@/components/PrefsControls.astro";
import SiteRail from "@/components/SiteRail.astro";
import SearchDialog, { type SearchItem } from "@/components/SearchDialog";
import { DEFAULT_SHARE_IMAGE, imageSize } from "@/lib/images";
import { BookOpenTextIcon } from "lucide-react";
import { getMainNav } from "@/lib/nav";
import { categoryLabels, getLocale, localizePath, ui } from "@/lib/i18n";
import { guideHref, searchGuides } from "@/lib/guides";

interface Props {
  locale?: "en" | "fr";
  title: string;
  description: string;
  /** Image de partage (Open Graph, Twitter), chemin sous public/ */
  image?: { src: string; alt: string } | undefined;
  type?: "website" | "article";
  /** Dates ISO pour les articles */
  modified?: string;
  /** Données structurées propres à la page (schema.org), ajoutées au graphe du site */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description, image, type = "website", modified, jsonLd = [], noindex = false } = Astro.props;
const current = Astro.url.pathname;
const locale = Astro.props.locale ?? getLocale(current);
const href = (path: string) => localizePath(path, locale);
const t = (en: string, fr: string) => ui(locale, en, fr);

const guideSearch = await searchGuides(locale);
const searchItems: SearchItem[] = [
  { href: href("/actualites/"), title: t("AION 2 news", "Actualités AION 2"), category: "Atreia", text: t("news official patch notes update maintenance events battle pass daeva shop", "actualités officiel patch mise à jour maintenance événements battle pass daeva boutique") },
  ...guideSearch.map((guide) => ({
    href: guideHref(guide.slug, locale),
    title: guide.title,
    category: categoryLabels[locale][guide.category],
    text: guide.text,
  })),
  { href: href("/serveurs/"), title: t("EU servers", "Serveurs EU"), category: "Atreia", text: t("servers europe pairs elyos asmodians early access f2p transfer", "serveurs europe paires elyos asmodiens accès anticipé f2p transfert") },
  { href: href("/classes/"), title: t("All 8 classes", "Les 8 classes"), category: "Atreia", text: t("classes gladiator templar assassin ranger sorcerer spiritmaster cleric chanter tier list ratings", "classes gladiateur templier assassin rôdeur sorcier spiritualiste clerc chantre tier list notes") },
];
const pageTitle = current === href("/") ? t("Atreia, AION 2 guides in English", "Atreia, guides AION 2 en français") : `${title} · Atreia`;
const canonical = new URL(current, Astro.site);

const share = image ?? { src: DEFAULT_SHARE_IMAGE, alt: t("Shattered Atreia, official AION 2 artwork", "Atréia brisée, fond officiel d'AION 2") };
const shareUrl = new URL(share.src, Astro.site).href;
const shareSize = imageSize(share.src);
const siteUrl = new URL(href("/"), Astro.site).href;
const graph = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${siteUrl}#site`, url: siteUrl, name: "Atreia", inLanguage: locale === "fr" ? "fr-FR" : "en-GB",
      description: t("AION 2 guides in English for European servers.", "Guides AION 2 en français pour les serveurs européens.") },
    { "@type": "VideoGame", "@id": `${siteUrl}#game`, name: "AION 2", publisher: { "@type": "Organization", name: "NC Corporation" } },
    ...jsonLd,
  ],
};
---
<!doctype html>
<html lang={locale} class="dark" data-faction="elyos" data-root="/" data-index="">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!noindex && ["en", "fr"].map((language) => <link rel="alternate" hreflang={language} href={new URL(localizePath(current, language as "en" | "fr"), Astro.site)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(localizePath(current, "en"), Astro.site)} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0b0b0c" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content="Atreia" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === "fr" ? "fr_FR" : "en_GB"} />
    <meta property="og:locale:alternate" content={locale === "fr" ? "en_GB" : "fr_FR"} />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content={String(shareSize.width)} />
    <meta property="og:image:height" content={String(shareSize.height)} />
    <meta property="og:image:alt" content={share.alt} />
    {type === "article" && modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareUrl} />
    <meta name="twitter:image:alt" content={share.alt} />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cpath d='M15 26C9 22 4 15 3 6c4 3 7 4 10 4-1 2-1 4 0 6-2 0-4 0-5-1 1 4 4 8 7 11z' fill='%23d9b45f'/%3E%3Cpath d='M17 26c6-4 11-11 12-20-4 3-7 4-10 4 1 2 1 4 0 6 2 0 4 0 5-1-1 4-4 8-7 11z' fill='%23e8643c'/%3E%3C/svg%3E" />
    <script is:inline>
      // Avant le premier rendu : faction mémorisée (le site est sombre uniquement).
      (function () {
        var f = null;
        try { f = localStorage.getItem("atreia-faction"); } catch (e) {}
        document.documentElement.dataset.faction = f === "asmodien" ? "asmodien" : "elyos";
      })();
    </script>
  </head>
  <body class="min-h-svh">
    <a href="#contenu" class="bg-primary text-primary-foreground sr-only z-[300] rounded-md px-3 py-2 focus:not-sr-only focus:fixed focus:top-2 focus:left-2">{t("Skip to content", "Aller au contenu")}</a>

    <SiteRail current={current} />

    <div class="md:pl-[96px]">
      <!-- Mobile : barre collante de 60 px (logo, recherche, menu). Desktop : header noir de 72 px sous lequel passe le rail. -->
      <header class="bg-chrome sticky top-0 z-[105] h-[60px] md:static md:h-[72px]">
        <div class="flex h-full items-center gap-[8px] pr-[12px] pl-[20px] md:gap-0 md:pr-[36px] md:pl-[36px]">
          <a href={href("/")} class="flex shrink-0 items-center gap-[8px] md:hidden">
            <Logo class="size-[32px]" />
            <span class="font-display hidden min-[360px]:inline text-[22px] font-semibold tracking-wide text-white">Atreia</span>
          </a>
          <a href={href("/guides/")} class="group hidden items-center gap-[12px] md:flex">
            <BookOpenTextIcon className="size-[22px] text-[#95989b] transition-colors group-hover:text-white" strokeWidth={1.5} />
            <span class="hidden text-[16px] leading-[24px] whitespace-nowrap text-[#808191] transition-colors group-hover:text-white lg:inline">{t("Browse guides", "Parcourir les guides")}</span>
          </a>
          <span class="mx-[24px] hidden h-[40px] w-px bg-[#2b2c2c] md:block" aria-hidden="true"></span>
          <div class="ml-auto md:ml-0 md:w-[260px] lg:w-[340px]">
            <SearchDialog client:idle items={searchItems} locale={locale} label={t("Search AION 2 guides", "Rechercher dans les guides AION 2")} />
          </div>
          <nav aria-label={t("Language", "Langue")} class="flex shrink-0 items-center md:ml-auto md:mr-4">
            {(["en", "fr"] as const).map((language) => <a
              href={localizePath(current, language)} lang={language} hreflang={language}
              aria-current={locale === language ? "page" : undefined}
              aria-label={language === "en" ? "English" : "Français"}
              class:list={["flex min-h-11 min-w-11 items-center justify-center rounded text-sm font-semibold transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary", locale === language ? "text-white" : "text-muted-foreground"]}
            >{language.toUpperCase()}</a>)}
          </nav>
          <div class="hidden md:block"><PrefsControls /></div>
          <MobileNav client:media="(max-width: 767px)" links={getMainNav(locale)} locale={locale} current={current} />
        </div>
      </header>

      <GameNav current={current} name="AION 2" />

      <main id="contenu">
        <slot />
      </main>

      <footer class="bg-chrome mt-[96px] md:rounded-tl-[32px]">
        <div class="mx-auto flex max-w-[1374px] flex-col items-center gap-[28px] px-[20px] pt-[72px] pb-[40px] text-center md:px-[24px]">
          <nav aria-label={t("Footer", "Pied de page")} class="flex flex-wrap justify-center gap-x-[40px] gap-y-[8px] text-[12px] leading-[18px] text-[#95989b]">
            <a href={href("/guides/")} class="hover:text-white">{t("All guides", "Tous les guides")}</a>
            <a href={href("/guides/annuaire-ressources/")} class="hover:text-white">{t("Sources and resources", "Sources et ressources")}</a>
            <a href={href("/serveurs/")} class="hover:text-white">{t("EU servers", "Serveurs EU")}</a>
            <a href="/sitemap-index.xml" class="hover:text-white">{t("Sitemap", "Plan du site")}</a>
          </nav>
          <div class="flex flex-col gap-[4px] text-[12px] leading-[18px] text-[#737373]">
            <p>{t("Atreia is an independent fan site. AION 2 and its trademarks belong to NCSoft.", "Atreia est un site de fans, non affilié aux éditeurs. AION 2 et ses marques appartiennent à NCSoft.")}</p>
            <p>{t("AION 2 images: © NC Corporation. All Rights Reserved.", "Images d'AION 2 : © NC Corporation. All Rights Reserved.")}</p>
            <p>{t("Every guide is dated and cites its sources. Check official announcements before spending.", "Chaque guide est daté et cite ses sources. Vérifie les annonces officielles avant de dépenser.")}</p>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>

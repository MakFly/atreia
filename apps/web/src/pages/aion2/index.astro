---
import { EU_FACTS } from "@aion2/shared/browser";
import { ArrowUpRightIcon, MapPinnedIcon, NewspaperIcon, SparklesIcon } from "lucide-react";
import GameHero from "@/components/GameHero.astro";
import HeroArt from "@/components/HeroArt.astro";
import HotTopics from "@/components/HotTopics.astro";
import Logo from "@/components/Logo.astro";
import NewsRow from "@/components/NewsRow.astro";
import PostCard from "@/components/PostCard.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import Base from "@/layouts/Base.astro";
import { allGuides } from "@/lib/guides";
import { formatDate } from "@/lib/utils";

const byDate = (await allGuides()).toSorted((a, b) => b.updated.localeCompare(a.updated));
const published = byDate.filter((g) => g.status === "publie");
const seasonal = published.slice(0, 5);
const fresh = published.slice(0, 3);
---
<Base title="AION 2" description="Guides AION 2 en français pour les serveurs européens : bien démarrer, builds, tier list des classes, serveurs et Kinah.">
  <div class="mx-auto max-w-[1374px] md:px-[24px]">
    <GameHero name="AION 2"
      description="Guides AION 2 en français : bien démarrer, builds de classes, tier list, serveurs européens, farm de Kinah et marché." />

    <div class="px-[12px] md:px-[12px]">
      <HotTopics guides={byDate} />

      <!-- Articles de la saison : panneau illustré, titre centré (relevé : 36/900) et 5 cartes verticales. -->
      <section class="relative isolate mt-[56px] overflow-hidden rounded-[12px] px-[12px] pt-[32px] pb-[16px] md:px-[16px]" aria-labelledby="saison">
        <div class="absolute inset-0 -z-10 opacity-50 [mask-image:linear-gradient(to_bottom,black,transparent_85%)]"><HeroArt /></div>
        <div class="flex items-center justify-center gap-[12px] text-center">
          <Logo class="size-[48px]" />
          <div class="text-left">
            <h2 id="saison" class="text-[26px] leading-[30px] font-black text-[#e8e8e8] uppercase md:text-[36px] md:leading-[36px]">Guides de la saison</h2>
            <p class="text-[14px] leading-[18px] text-[#e8e8e8]">Les articles pour bien vivre la Saison 1 globale.</p>
          </div>
        </div>
        <ul class="no-scrollbar mt-[24px] flex snap-x gap-[8px] overflow-x-auto pb-[4px]">
          {seasonal.map((g) => (
            <li class="w-[248px] shrink-0 snap-start xl:w-auto xl:flex-1"><PostCard guide={g} /></li>
          ))}
        </ul>
      </section>

      <section class="mt-[56px]" aria-labelledby="nouveautes">
        <SectionTitle id="nouveautes" icon={SparklesIcon} title="Nouveautés" subtitle="Nos dernières mises à jour." color="#d4c400" />
        <ul class="mt-[24px] grid gap-[12px] md:grid-cols-3">
          {fresh.map((g) => <li><PostCard guide={g} large /></li>)}
        </ul>
        <p class="mt-[12px] text-right">
          <a href="/aion2/guides/" class="inline-flex items-center gap-[4px] text-[14px] text-[#95989b] hover:text-white">Tous les guides <ArrowUpRightIcon className="size-[14px]" /></a>
        </p>
      </section>

      <!-- Emplacement du sondage sur la référence : ici, les repères EU datés et sourcés. -->
      <section class="relative isolate mt-[48px] grid overflow-hidden rounded-[12px] bg-[#121212] shadow-[inset_0_0_1px_0_#2b2c2c] md:grid-cols-[260px_1fr]" aria-labelledby="reperes">
        <div class="relative hidden md:block"><HeroArt /><div class="absolute inset-0 flex items-center justify-center"><Logo class="size-[96px]" /></div></div>
        <div class="p-[20px] md:p-[24px]">
          <h2 id="reperes" class="flex items-center gap-[10px] text-[24px] leading-[28px] font-bold text-white uppercase">
            <MapPinnedIcon className="size-[22px] text-[#057af0]" /> Repères EU
          </h2>
          <p class="mt-[4px] text-[16px] text-[#e8e8e8]">Ce qu'il faut savoir avant de choisir ton serveur.</p>
          <dl class="mt-[16px] grid gap-[8px] sm:grid-cols-2 xl:grid-cols-3">
            {EU_FACTS.map((f) => (
              <div class="flex flex-col rounded-[6px] bg-[#171717] px-[12px] py-[8px] shadow-[inset_0_0_1px_0_#2b2c2c]">
                <dt class="text-[13px] leading-[18px] text-[#95989b]">{f.label}</dt>
                <dd class="text-[16px] leading-[22px] font-semibold text-white">{f.value}</dd>
                <dd><a href={f.source.url} target="_blank" rel="noopener noreferrer" class="text-[12px] leading-[16px] text-[#737373] hover:text-white hover:underline">{f.source.name}, {formatDate(f.asOf)}</a></dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <section class="mt-[56px]" aria-labelledby="actus">
        <SectionTitle id="actus" icon={NewspaperIcon} title="Dernières actus" subtitle="Ce qui bouge en ce moment." color="#057af0" />
        <ul class="mt-[24px] flex flex-col gap-[8px]">
          {published.map((g) => <li><NewsRow guide={g} /></li>)}
        </ul>
      </section>
    </div>
  </div>
</Base>

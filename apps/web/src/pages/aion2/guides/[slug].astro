---
import { CATEGORIES, CLASSES } from "@aion2/shared/browser";
import { CheckIcon, LinkIcon, ThumbsDownIcon, ThumbsUpIcon, XIcon } from "lucide-react";
import ClassSigil from "@/components/ClassSigil.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import GameHero from "@/components/GameHero.astro";
import Grade from "@/components/Grade.astro";
import Base from "@/layouts/Base.astro";
import { toMeta } from "@/lib/guides";
import { catColor } from "@/lib/cats";
import { formatDate } from "@/lib/utils";
import { type CollectionEntry, getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("guides");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<"guides"> }
const { entry } = Astro.props;
const guide = toMeta(entry);
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={guide.title} description={guide.summary}>
  <div class="mx-auto max-w-[1374px] md:px-[24px]">
    <GameHero name="AION 2" compact />
    <div class="mt-[20px]">
      <Breadcrumb items={[{ label: "AION 2", href: "/aion2/" }, { label: "Guides", href: "/aion2/guides/" }, { label: guide.title }]} />
    </div>

    <!-- Relevé maxroll.gg : colonne gauche 210 px (auteur + sommaire collant), contenu 1030 px, écart 16 px. -->
    <div class="mt-[32px] grid gap-[16px] px-[20px] lg:grid-cols-[210px_minmax(0,1fr)]">
      <aside class="hidden flex-col gap-[12px] lg:flex">
        {guide.classes.length > 0 && (
          <div class="overflow-hidden rounded-[8px] bg-[#121212] shadow-[inset_0_0_1px_0_#2b2c2c]">
            <p class="pt-[16px] text-center text-[18px] leading-[18px] font-semibold text-white uppercase">Classes</p>
            <ul class="flex flex-col items-center gap-[10px] px-[12px] py-[16px]">
              {guide.classes.map((c) => (
                <li class="flex flex-col items-center gap-[4px]">
                  <ClassSigil cls={c} class="size-[72px]" />
                  <span class="text-[16px] leading-[20px] font-semibold text-white">{CLASSES[c].name}</span>
                  <span class="text-[13px] leading-[16px] text-[#95989b] italic">{CLASSES[c].weapon}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
        {toc.length > 0 && (
          <nav aria-label="Sommaire" class="sticky top-[80px] overflow-hidden rounded-[8px] bg-[#121212] shadow-[inset_0_0_1px_0_#2b2c2c]">
            <p class="px-[12px] py-[16px] text-center text-[18px] leading-[22.5px] font-semibold text-white uppercase">Sommaire</p>
            <ol class="flex flex-col gap-[4px] px-[12px] pb-[12px]">
              {toc.map((h, i) => (
                <li>
                  <a href={`#${h.slug}`} data-toc={h.slug}
                    class="relative flex gap-[6px] rounded-[4px] bg-[#171717] py-[8px] pr-[8px] pl-[14px] text-[14px] leading-[18px] text-[#95989b] transition-colors hover:text-white data-[active]:font-semibold data-[active]:text-white">
                    <span class="absolute top-[10px] bottom-[10px] left-[4px] hidden w-[3px] rounded-full bg-[#057af0] [[data-active]>&]:block" aria-hidden="true"></span>
                    {!/^\d+[.)]/.test(h.text) && <span>{i + 1}.</span>}<span>{h.text}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )}
      </aside>

      <article class="flex min-w-0 flex-col gap-[24px]">
        <h1 class="text-[26px] leading-[34px] font-semibold text-[#e8e8e8] md:text-[32px] md:leading-[40px]">{guide.title}</h1>

        <!-- Bloc d'en-tête : infos à gauche, actions au centre, « L'essentiel » à la place de l'encart pub. -->
        <div class="grid gap-[8px] xl:grid-cols-[minmax(0,1fr)_300px]">
          <div class="flex flex-col gap-[16px] rounded-[8px] bg-[#121212] p-[12px] shadow-[inset_0_0_1px_0_#2b2c2c] sm:flex-row sm:justify-between">
            <div class="flex flex-col gap-[8px]">
              <p class="text-[16px] text-[#95989b]">par <span class="font-semibold text-[#e8e8e8]">Atreia</span></p>
              <p class="text-[20px] leading-[24px] font-medium text-[#dadada]">{guide.patch}</p>
              <p class="text-[16px] text-[#737373]">Dernière mise à jour : {formatDate(guide.updated)}{guide.status === "publie" && <> · {guide.readingMinutes} min de lecture</>}</p>
              <div class="flex flex-wrap gap-[6px]">
                <span class="flex items-center gap-[6px] rounded-[4px] bg-[#171717] px-[10px] text-[14px] leading-[24px] text-[#95989b] shadow-[inset_0_0_1px_0_#2b2c2c]">
                  <span class="size-[8px] rounded-[2px]" style={`background:${catColor(guide.category)}`} aria-hidden="true"></span>{CATEGORIES[guide.category].label}
                </span>
                {guide.status === "a-venir" && <span class="rounded-[4px] bg-[#ffb547] px-[10px] text-[14px] leading-[24px] font-semibold text-black">En préparation</span>}
              </div>
            </div>
            <div class="flex shrink-0 gap-[8px] self-start">
              <button type="button" data-copy-link
                class="flex h-[36px] items-center gap-[8px] rounded-[8px] bg-[#171717] px-[14px] text-[16px] font-semibold text-[#dadada] shadow-[inset_0_0_1px_0_#2b2c2c,0_0_1px_0_#2b2c2c] transition-colors hover:text-white">
                <LinkIcon className="size-[16px] text-[#057af0]" /><span data-copy-label>Copier le lien</span>
              </button>
            </div>
          </div>
          {guide.highlights.length > 0 && (
            <section aria-label="L'essentiel" class="rounded-[8px] bg-[#121212] p-[12px] shadow-[inset_0_0_1px_0_#2b2c2c]">
              <p class="text-center text-[18px] leading-[22.5px] font-semibold text-white uppercase">L'essentiel</p>
              <ul class="mt-[10px] flex flex-col gap-[8px]">
                {guide.highlights.map((h) => (
                  <li class="flex gap-[8px] text-[14px] leading-[20px] text-[#dadada]"><CheckIcon className="mt-[2px] size-[16px] shrink-0 text-[#6ab525]" aria-hidden="true" /><span>{h}</span></li>
                ))}
              </ul>
            </section>
          )}
        </div>

        <p class="text-[16px] leading-[24px] text-[#dadada]">{guide.summary}</p>

        {guide.ratings.length > 0 && (
          <ul class="grid grid-cols-2 gap-[8px] sm:grid-cols-4" aria-label="Notes du build">
            {guide.ratings.map((r) => (
              <li class="flex items-center gap-[10px] rounded-[8px] bg-[#121212] p-[10px] shadow-[inset_0_0_1px_0_#2b2c2c]">
                <Grade grade={r.grade} size="md" /><span class="text-[16px] font-semibold text-white">{r.label}</span>
              </li>
            ))}
          </ul>
        )}

        {(guide.pros.length > 0 || guide.cons.length > 0) && (
          <div class="grid gap-[12px] sm:grid-cols-2">
            <div class="overflow-hidden rounded-[8px] bg-[#121212] shadow-[inset_0_0_1px_0_#2b2c2c]">
              <p class="inline-flex h-[36px] items-center gap-[8px] rounded-br-[8px] bg-[#1d4d24] px-[16px] text-[18px] font-semibold text-white"><ThumbsUpIcon className="size-[16px]" />Points forts</p>
              <ul class="flex flex-col gap-[8px] p-[16px]">
                {guide.pros.map((p) => <li class="flex gap-[8px] text-[14px] leading-[20px] text-[#dadada]"><CheckIcon className="mt-[2px] size-[14px] shrink-0 text-[#6ab525]" aria-hidden="true" />{p}</li>)}
              </ul>
            </div>
            <div class="overflow-hidden rounded-[8px] bg-[#121212] shadow-[inset_0_0_1px_0_#2b2c2c]">
              <p class="inline-flex h-[36px] items-center gap-[8px] rounded-br-[8px] bg-[#5c1515] px-[16px] text-[18px] font-semibold text-white"><ThumbsDownIcon className="size-[16px]" />Points faibles</p>
              <ul class="flex flex-col gap-[8px] p-[16px]">
                {guide.cons.map((c) => <li class="flex gap-[8px] text-[14px] leading-[20px] text-[#dadada]"><XIcon className="mt-[2px] size-[14px] shrink-0 text-[#f05252]" aria-hidden="true" />{c}</li>)}
              </ul>
            </div>
          </div>
        )}

        <div class="prose-guide">
          <Content />
        </div>
      </article>
    </div>
  </div>
</Base>

<script>
  // Surligne la section en cours dans le sommaire.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>("[data-toc]")].map((a) => [a.dataset.toc!, a]),
  );
  if (links.size > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => a.removeAttribute("data-active"));
          links.get(e.target.id)?.setAttribute("data-active", "");
        }
      },
      { rootMargin: "-90px 0px -70% 0px" },
    );
    links.forEach((_a, id) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  }

  // « Copier le lien » : presse-papiers si disponible, sinon sélection de l'URL.
  document.querySelector<HTMLButtonElement>("[data-copy-link]")?.addEventListener("click", async (e) => {
    const label = (e.currentTarget as HTMLElement).querySelector<HTMLElement>("[data-copy-label]");
    try {
      await navigator.clipboard.writeText(location.href.split("#")[0] ?? location.href);
      if (label) { label.textContent = "Lien copié"; setTimeout(() => (label.textContent = "Copier le lien"), 2000); }
    } catch {
      prompt("Copie ce lien :", location.href);
    }
  });
</script>
